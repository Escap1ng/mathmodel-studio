{
  "name": "mathmodel-studio",
  "version": "0.6.1",
  "private": true,
  "description": "数学建模竞赛桌面 Agent：白底三栏工作台，人在环的选模、解释、门禁与评分",
  "author": "Escap1ng",
  "license": "AGPL-3.0-only",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "vendor:python": "node scripts/prepare-vendor.mjs python",
    "vendor:pandoc": "node scripts/prepare-vendor.mjs pandoc",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check:registry": "node scripts/check-registry.mjs",
    "check:registry:negative": "node scripts/check-registry.negative.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:skills:negative": "node scripts/check-skills.mjs --self",
    "check:contracts": "python scripts/validate_contracts.py",
    "check:cli": "python runtime/selfcheck.py",
    "check:channel": "python runtime/selfcheck_channel.py",
    "check:channel:negative": "python runtime/selfcheck_channel.py --selftest",
    "check:orchestrator": "python runtime/selfcheck_orchestrator.py",
    "check:orchestrator:negative": "python runtime/selfcheck_orchestrator.py --selftest",
    "check:harness": "python runtime/selfcheck_harness.py",
    "check:harness:negative": "python runtime/selfcheck_harness.py --selftest",
    "check:xlsx": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-xlsx.mjs",
    "mms": "python runtime/cli.py",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:window": "electron tests/window-smoke.cjs",
    "verify:window": "node scripts/check-window-smoke.mjs",
    "verify:window:selftest": "node scripts/check-window-smoke.mjs --selftest",
    "gate": "npm run check:registry && npm run check:registry:negative && npm run check:skills && npm run check:skills:negative && npm run verify:window:selftest && npm run typecheck && npm run build && npm run smoke:dist && npm run check:contracts && npm run check:cli && npm run check:channel && npm run check:channel:negative && npm run check:orchestrator && npm run check:orchestrator:negative && npm run check:harness && npm run check:harness:negative && npm run check:xlsx && npm run check:workbench && npm run check:paper",
    "check:workbench": "python runtime/selfcheck_workbench.py",
    "check:paper": "python runtime/selfcheck_paper.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  }
}
